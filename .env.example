# Copy to .env.local and fill in. Both values are public (they ship in the browser bundle).
# Never put the secret key or the service_role key here.
# Local: `npx supabase status` prints the API URL and the publishable key.
# Hosted: Supabase dashboard > Project Settings > API Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
