{
  "$description": "Cycling Hub design tokens, direction C Deep Ocean (P29), v1.1 (17 Oct 2026, PO design review D-PO1 to D-PO7 applied). W3C design-tokens style. Mirrors src/styles/tokens.css; DESIGN.md explains usage. cssVar = the custom property name in tokens.css.",
  "color": {
    "dark": {
      "bg":             { "$type": "color", "$value": "#111318", "cssVar": "--bg", "$description": "App background under the splash" },
      "bg-top":         { "$type": "color", "$value": "#16181E", "cssVar": "--bg-top" },
      "bg-bottom":      { "$type": "color", "$value": "#0F1116", "cssVar": "--bg-bottom" },
      "surface":        { "$type": "color", "$value": "#191C22", "cssVar": "--surface", "$description": "Cards, groups, table" },
      "surface-hover":  { "$type": "color", "$value": "#1E2128", "cssVar": "--surface-hover" },
      "raised":         { "$type": "color", "$value": "#23262C", "cssVar": "--raised", "$description": "Floating cards, drawer, active nav item" },
      "fill":           { "$type": "color", "$value": "#23262C", "cssVar": "--fill", "$description": "Tone-step fill: secondary button, segmented track, tiles, skeleton" },
      "fill-hover":     { "$type": "color", "$value": "#2A2E35", "cssVar": "--fill-hover" },
      "track":          { "$type": "color", "$value": "#0F1116", "cssVar": "--track", "$description": "Inset track: segmented control, progress bar" },
      "border":         { "$type": "color", "$value": "#30343B", "cssVar": "--border", "$description": "Table and list dividers only" },
      "input-border":   { "$type": "color", "$value": "#6E7279", "cssVar": "--input-border", "contrast": { "surface": 3.53, "bg": 3.85 } },
      "text":           { "$type": "color", "$value": "#E6EDF7", "cssVar": "--text", "contrast": { "bg": 15.77, "surface": 14.48, "raised": 12.87 } },
      "muted":          { "$type": "color", "$value": "#A1A5AB", "cssVar": "--muted", "contrast": { "bg": 7.51, "surface": 6.9, "raised": 6.13 } },
      "accent":         { "$type": "color", "$value": "#5B9BFF", "cssVar": "--accent", "contrast": { "bg": 6.7, "surface": 6.16, "raised": 5.47 } },
      "accent-hover":   { "$type": "color", "$value": "#7AAEFF", "cssVar": "--accent-hover" },
      "accent-pressed": { "$type": "color", "$value": "#4A88EA", "cssVar": "--accent-pressed" },
      "on-accent":      { "$type": "color", "$value": "#0D1015", "cssVar": "--on-accent", "contrast": { "accent": 6.88 } },
      "accent-soft":    { "$type": "color", "$value": "rgba(91,155,255,0.14)", "cssVar": "--accent-soft" },
      "positive":       { "$type": "color", "$value": "#8FD07A", "cssVar": "--positive", "contrast": { "surface": 9.32 } },
      "positive-soft":  { "$type": "color", "$value": "rgba(143,208,122,0.12)", "cssVar": "--positive-soft" },
      "danger":         { "$type": "color", "$value": "#FF8A80", "cssVar": "--danger", "contrast": { "surface": 7.48, "raised": 6.64 } },
      "on-danger":      { "$type": "color", "$value": "#0D1015", "cssVar": "--on-danger" },
      "danger-soft":    { "$type": "color", "$value": "rgba(255,138,128,0.12)", "cssVar": "--danger-soft" },
      "focus":          { "$type": "color", "$value": "#5B9BFF", "cssVar": "--focus", "contrast": { "bg": 6.7, "surface": 6.16 } },
      "overlay":        { "$type": "color", "$value": "rgba(5,6,8,0.6)", "cssVar": "--overlay", "$description": "Scrim behind the phone drawer" }
    },
    "light": {
      "bg":             { "$type": "color", "$value": "#F2F5F9", "cssVar": "--bg" },
      "bg-top":         { "$type": "color", "$value": "#F6F8FB", "cssVar": "--bg-top" },
      "bg-bottom":      { "$type": "color", "$value": "#ECF0F6", "cssVar": "--bg-bottom" },
      "surface":        { "$type": "color", "$value": "#FFFFFF", "cssVar": "--surface" },
      "surface-hover":  { "$type": "color", "$value": "#F7F9FC", "cssVar": "--surface-hover" },
      "raised":         { "$type": "color", "$value": "#FFFFFF", "cssVar": "--raised" },
      "fill":           { "$type": "color", "$value": "#E6EAF0", "cssVar": "--fill" },
      "fill-hover":     { "$type": "color", "$value": "#DCE1E8", "cssVar": "--fill-hover" },
      "track":          { "$type": "color", "$value": "#E6EAF0", "cssVar": "--track" },
      "border":         { "$type": "color", "$value": "#DDDFE2", "cssVar": "--border" },
      "input-border":   { "$type": "color", "$value": "#74777C", "cssVar": "--input-border", "contrast": { "surface": 4.49, "bg": 4.1, "splash-worst": 3.5 } },
      "text":           { "$type": "color", "$value": "#171A1F", "cssVar": "--text", "contrast": { "bg": 15.95, "surface": 17.44, "fill": 14.45 } },
      "muted":          { "$type": "color", "$value": "#5C6067", "cssVar": "--muted", "contrast": { "bg": 5.78, "surface": 6.32, "fill": 5.23 } },
      "accent":         { "$type": "color", "$value": "#2457D6", "cssVar": "--accent", "contrast": { "bg": 5.63, "surface": 6.16, "fill": 5.1 } },
      "accent-hover":   { "$type": "color", "$value": "#1D49B8", "cssVar": "--accent-hover" },
      "accent-pressed": { "$type": "color", "$value": "#193F9F", "cssVar": "--accent-pressed" },
      "on-accent":      { "$type": "color", "$value": "#FFFFFF", "cssVar": "--on-accent", "contrast": { "accent": 6.16 } },
      "accent-soft":    { "$type": "color", "$value": "rgba(36,87,214,0.09)", "cssVar": "--accent-soft" },
      "positive":       { "$type": "color", "$value": "#2F6A1C", "cssVar": "--positive", "contrast": { "bg": 6.0, "fill": 5.44 } },
      "positive-soft":  { "$type": "color", "$value": "rgba(47,106,28,0.1)", "cssVar": "--positive-soft" },
      "danger":         { "$type": "color", "$value": "#B3261E", "cssVar": "--danger", "contrast": { "surface": 6.54, "bg": 5.98 } },
      "on-danger":      { "$type": "color", "$value": "#FFFFFF", "cssVar": "--on-danger" },
      "danger-soft":    { "$type": "color", "$value": "rgba(179,38,30,0.08)", "cssVar": "--danger-soft" },
      "focus":          { "$type": "color", "$value": "#2457D6", "cssVar": "--focus", "contrast": { "bg": 5.63, "surface": 6.16 } },
      "overlay":        { "$type": "color", "$value": "rgba(23,26,31,0.36)", "cssVar": "--overlay" }
    }
  },
  "metric": {
    "$description": "Fixed colour per metric (P20). Order everywhere: distance, moving time, avg speed, avg power, avg HR, elevation (P10). All >= 4.5:1 on bg, surface, raised and fill in their theme.",
    "dist":  { "label": "Distance",        "unit": "km",   "cssVar": "--m-dist",  "dark": { "$type": "color", "$value": "#56D2AC" }, "light": { "$type": "color", "$value": "#0D7050" } },
    "time":  { "label": "Moving time",     "unit": "h",    "cssVar": "--m-time",  "dark": { "$type": "color", "$value": "#C8CBD0" }, "light": { "$type": "color", "$value": "#5A5F66" } },
    "speed": { "label": "Avg speed",       "unit": "km/h", "cssVar": "--m-speed", "dark": { "$type": "color", "$value": "#9DD9F0" }, "light": { "$type": "color", "$value": "#1F6585" } },
    "power": { "label": "Avg power",       "unit": "W",    "cssVar": "--m-power", "dark": { "$type": "color", "$value": "#E9CD4C" }, "light": { "$type": "color", "$value": "#806200" } },
    "hr":    { "label": "Avg heart rate",  "unit": "bpm",  "cssVar": "--m-hr",    "dark": { "$type": "color", "$value": "#E8728F" }, "light": { "$type": "color", "$value": "#A63A5B" } },
    "elev":  { "label": "Elevation",       "unit": "m",    "cssVar": "--m-elev",  "dark": { "$type": "color", "$value": "#D6A97A" }, "light": { "$type": "color", "$value": "#6B4A2B" } }
  },
  "zone": {
    "$description": "Training zone colours (P40, P53). Power zones 1 to 7 (Coggan); heart rate zones 1 to 5 reuse zone-1 to zone-5. A sequence from easy to hard, not metric colours. Never the only signal: a zone always shows its number and name too. Every value is at least 3:1 on bg, surface and raised in its theme (UI part, WCAG 1.4.11); measured values are in DESIGN.md.",
    "1": { "label": "Z1", "name": "Active recovery", "cssVar": "--zone-1", "dark": { "$type": "color", "$value": "#9AA3B2" }, "light": { "$type": "color", "$value": "#5A6472" } },
    "2": { "label": "Z2", "name": "Endurance", "cssVar": "--zone-2", "dark": { "$type": "color", "$value": "#6DB6F0" }, "light": { "$type": "color", "$value": "#1A62A3" } },
    "3": { "label": "Z3", "name": "Tempo", "cssVar": "--zone-3", "dark": { "$type": "color", "$value": "#56D2AC" }, "light": { "$type": "color", "$value": "#0D7050" } },
    "4": { "label": "Z4", "name": "Threshold", "cssVar": "--zone-4", "dark": { "$type": "color", "$value": "#E9CD4C" }, "light": { "$type": "color", "$value": "#806200" } },
    "5": { "label": "Z5", "name": "VO2 max", "cssVar": "--zone-5", "dark": { "$type": "color", "$value": "#F0A04B" }, "light": { "$type": "color", "$value": "#A64B00" } },
    "6": { "label": "Z6", "name": "Anaerobic capacity", "cssVar": "--zone-6", "dark": { "$type": "color", "$value": "#FF7A6B" }, "light": { "$type": "color", "$value": "#B3261E" } },
    "7": { "label": "Z7", "name": "Neuromuscular power", "cssVar": "--zone-7", "dark": { "$type": "color", "$value": "#C58CFF" }, "light": { "$type": "color", "$value": "#7A3EC4" } }
  },
  "font": {
    "family": { "sans": { "$type": "fontFamily", "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "cssVar": "--font-sans", "$description": "Inter is shipped with the app (D-PO7): self-hosted variable woff2, no CDN, font-display: swap.", "files": { "upright": "/fonts/InterVariable.woff2", "license": "/fonts/LICENSE.txt (SIL OFL 1.1)" }, "fontWeightRange": "100 900", "fontDisplay": "swap", "subset": "Latin" } },
    "numeric": { "$type": "string", "$value": "tabular-nums", "cssVar": "--font-numeric" },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400, "cssVar": "--fw-regular" },
      "medium":   { "$type": "fontWeight", "$value": 500, "cssVar": "--fw-medium" },
      "semibold": { "$type": "fontWeight", "$value": 600, "cssVar": "--fw-semibold" }
    },
    "scale": {
      "caption": { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400 }, "cssVar": "--fs-caption", "use": "Meta, units, helper text, table header. Minimum size." },
      "body":    { "$type": "typography", "$value": { "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400 }, "cssVar": "--fs-body", "use": "Body, rows, inputs, buttons (600), table cells" },
      "body-lg": { "$type": "typography", "$value": { "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600 }, "cssVar": "--fs-body-lg", "use": "Metric values on ride cards, ride name" },
      "title":   { "$type": "typography", "$value": { "fontSize": "20px", "lineHeight": "26px", "fontWeight": 600, "letterSpacing": "-0.01em" }, "cssVar": "--fs-title", "use": "Top bar title, card titles" },
      "heading": { "$type": "typography", "$value": { "fontSize": "24px", "lineHeight": "30px", "fontWeight": 600, "letterSpacing": "-0.015em" }, "cssVar": "--fs-heading", "use": "Desktop page title, phone screen headline" },
      "stat":    { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "36px", "fontWeight": 600, "letterSpacing": "-0.025em" }, "cssVar": "--fs-stat", "use": "Import outcome numbers, stat blocks" },
      "display": { "$type": "typography", "$value": { "fontSize": "44px", "lineHeight": "46px", "fontWeight": 600, "letterSpacing": "-0.025em" }, "cssVar": "--fs-display", "use": "One hero number per screen (ride detail)" }
    }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "4px",  "cssVar": "--space-1" },
    "2":  { "$type": "dimension", "$value": "8px",  "cssVar": "--space-2" },
    "3":  { "$type": "dimension", "$value": "12px", "cssVar": "--space-3" },
    "4":  { "$type": "dimension", "$value": "16px", "cssVar": "--space-4" },
    "5":  { "$type": "dimension", "$value": "20px", "cssVar": "--space-5" },
    "6":  { "$type": "dimension", "$value": "24px", "cssVar": "--space-6" },
    "8":  { "$type": "dimension", "$value": "32px", "cssVar": "--space-8" },
    "10": { "$type": "dimension", "$value": "40px", "cssVar": "--space-10" },
    "12": { "$type": "dimension", "$value": "48px", "cssVar": "--space-12" },
    "16": { "$type": "dimension", "$value": "64px", "cssVar": "--space-16" }
  },
  "size": {
    "target-min":  { "$type": "dimension", "$value": "44px",   "cssVar": "--target-min" },
    "control-h":   { "$type": "dimension", "$value": "44px",   "cssVar": "--control-h" },
    "row-h":       { "$type": "dimension", "$value": "52px",   "cssVar": "--row-h" },
    "table-row-h": { "$type": "dimension", "$value": "44px",   "cssVar": "--table-row-h" },
    "topbar-h":    { "$type": "dimension", "$value": "56px",   "cssVar": "--topbar-h" },
    "sidebar-w":   { "$type": "dimension", "$value": "232px",  "cssVar": "--sidebar-w" },
    "drawer-w":    { "$type": "dimension", "$value": "300px",  "cssVar": "--drawer-w" },
    "content-max": { "$type": "dimension", "$value": "1120px", "cssVar": "--content-max" },
    "form-max":    { "$type": "dimension", "$value": "400px",  "cssVar": "--form-max" },
    "page-margin": { "$type": "dimension", "$value": "16px",   "cssVar": "--page-margin" },
    "breakpoint-desktop": { "$type": "dimension", "$value": "960px", "$description": "Permanent side menu and table from this width (media queries cannot read custom properties)" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px",   "cssVar": "--radius-sm" },
    "md":   { "$type": "dimension", "$value": "12px",  "cssVar": "--radius-md" },
    "lg":   { "$type": "dimension", "$value": "16px",  "cssVar": "--radius-lg" },
    "xl":   { "$type": "dimension", "$value": "20px",  "cssVar": "--radius-xl" },
    "full": { "$type": "dimension", "$value": "999px", "cssVar": "--radius-full", "$description": "Feature / Fix / Technical labels only (P24)" }
  },
  "shadow": {
    "rest":  { "$type": "shadow", "$value": "none", "cssVar": "--shadow", "$description": "Nothing at rest has a shadow (P28)" },
    "float": {
      "cssVar": "--shadow-raised",
      "alias": "--shadow-float",
      "$description": "Only on what floats: the phone bottom status card (the desktop one sits in the side menu without a shadow, D-PO2), drawer, menus, dialogs. Neutral black, never tinted (P21).",
      "dark":  { "$type": "shadow", "$value": "0 2px 4px rgba(0,0,0,0.3), 0 8px 20px rgba(0,0,0,0.25)" },
      "light": { "$type": "shadow", "$value": "0 2px 4px rgba(0,0,0,0.06), 0 8px 20px rgba(0,0,0,0.07)" }
    }
  },
  "focus": {
    "width":  { "$type": "dimension", "$value": "2px", "cssVar": "--focus-width" },
    "offset": { "$type": "dimension", "$value": "2px", "cssVar": "--focus-offset" },
    "ring":   { "$type": "string", "$value": "2px solid var(--focus)", "cssVar": "--focus-ring", "$description": "Use as outline; never a blurred box-shadow (P21)" }
  },
  "motion": {
    "duration": {
      "fast":  { "$type": "duration", "$value": "120ms", "cssVar": "--dur-fast" },
      "base":  { "$type": "duration", "$value": "200ms", "cssVar": "--dur-base" },
      "slow":  { "$type": "duration", "$value": "320ms", "cssVar": "--dur-slow" },
      "count": { "$type": "duration", "$value": "800ms", "cssVar": "--dur-count" }
    },
    "easing": {
      "out":    { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1], "cssVar": "--ease-out" },
      "in-out": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1],   "cssVar": "--ease-in-out" }
    },
    "reduced": { "$description": "Under prefers-reduced-motion all durations become 0ms; content still appears." }
  },
  "background": {
    "splash": {
      "cssVar": "--splash",
      "alias": "--page",
      "$description": "Gradient splash (P25): three large radial fields from accent and distance colour over bg. The app background (decided, D-PO1; Q4 closed). Screen background only. data-background=\"flat\" is a technical fallback only, not a user choice. The flow-lines variant (P26, P27) is dropped.",
      "strength": {
        "dark":  { "a": "18%", "b": "13%", "c": "8%" },
        "light": { "a": "16%", "b": "12%", "c": "7%" }
      },
      "layers": [
        "radial-gradient(120% 55% at 0% 0%, accent a, transparent 70%)",
        "radial-gradient(90% 50% at 100% 45%, m-dist b, transparent 70%)",
        "radial-gradient(100% 45% at 30% 100%, accent c, transparent 70%)",
        "bg"
      ]
    }
  }
}
